# Copy to .env. EXPO_PUBLIC_* values are bundled into the app (they are not secret).

# Flask server. Use your computer's LAN IP so the phone can reach it, e.g. http://192.168.1.20:5001
EXPO_PUBLIC_API_URL=http://localhost:5001

# Firebase web config (Firebase console > Project settings > Your apps).
# Leave EXPO_PUBLIC_FIREBASE_API_KEY blank to run in dev mode (any email/password logs in).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
