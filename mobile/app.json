{
  "expo": {
    "name": "GuideSight",
    "slug": "guidesight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guidesight.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guidesight.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "GuideSight uses the camera to describe what is ahead of you.",
          "microphonePermission": "GuideSight listens for your voice questions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "GuideSight listens for your voice questions."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GuideSight logs where your dog stops so you can review your routes."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "GuideSight connects to your dog's harness over Bluetooth."
        }
      ]
    ],
    "scheme": "guidesight"
  }
}
