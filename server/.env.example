# Leave a key blank to run that service in mock mode (canned responses, in-memory storage).

# Firebase Admin (Auth token verification + Firestore).
# Path to a service-account JSON from Firebase console > Project settings > Service accounts.
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# AssemblyAI speech-to-text
ASSEMBLYAI_API_KEY=

# Shared secret the harness sends when it connects (HARNESS_KEY in firmware/uno_r4/arduino_secrets.h).
# Blank = any harness may connect, which only works while Firebase is off.
HARNESS_KEY=

# Comma-separated origins allowed to call the API (dashboard dev server)
CORS_ORIGINS=http://localhost:5173

PORT=5001
