# Leave a key blank to run that service in mock mode (canned responses, in-memory storage).

# Firestore storage. Path to a service-account JSON from Firebase console > Project settings >
# Service accounts. Blank = in-memory storage (lost on restart).
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Set to true if GEMINI_API_KEY is a Google Cloud Agent Platform key (not AI Studio)
GEMINI_VERTEX=false

# ElevenLabs: speech-to-text (Scribe) for questions, text-to-speech for spoken alerts
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Any voice ID from your ElevenLabs Voice Library. Default: George.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Shared secret the harness sends when it connects (HARNESS_KEY in firmware/uno_r4/arduino_secrets.h).
# Blank = any harness may connect.
HARNESS_KEY=

# Comma-separated origins allowed to call the API (dashboard dev server)
CORS_ORIGINS=http://localhost:5173

PORT=5001
