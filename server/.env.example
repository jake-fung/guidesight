# Leave a key blank to run that service in mock mode (canned responses, in-memory storage).

# Auth0 login. Domain from Applications > your app; audience = APIs > your API's identifier.
# Both blank = mock mode: any token is accepted as one dev user.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Firestore storage. Path to a service-account JSON from Firebase console > Project settings >
# Service accounts. Blank = in-memory storage (lost on restart).
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ElevenLabs speech-to-text (Scribe)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Shared secret the harness sends when it connects (HARNESS_KEY in firmware/uno_r4/arduino_secrets.h).
# Blank = any harness may connect, which only works while Auth0 is off.
HARNESS_KEY=

# Comma-separated origins allowed to call the API (dashboard dev server)
CORS_ORIGINS=http://localhost:5173

PORT=5001
