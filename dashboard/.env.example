# Flask server URL. Leave blank in dev: Vite forwards /api to localhost:5001 (vite.config.ts).
# Set it when the server is deployed somewhere other than the web app.
VITE_API_URL=

# Auth0 (Applications > your Single Page Application, and APIs > your API's identifier).
# Leave VITE_AUTH0_DOMAIN blank for dev mode (no login, needs the server without Auth0 too).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
