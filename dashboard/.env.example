# Flask server URL. Leave blank in dev: Vite forwards /api to localhost:5001 (vite.config.ts).
# Set it when the server is deployed somewhere other than the web app.
VITE_API_URL=

# Firebase web config (Firebase console > Project settings > Your apps). Leave the API key blank for dev mode (no login).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
